# ============================================================
#  NUZHANG: bu faylni .env deb nusxalang va o'zingiz to'ldiring
#  BOT_TOKEN ni @BotFather'dan O'ZINGIZ olasiz.
#  Bu faylga yozilgan token GIT'ga bormaydi (.gitignore tekshirilgan).
# ============================================================

# 1) @BotFather -> /newbot -> olingan token. Faqat shu joyda turadi.
BOT_TOKEN=

# 2) Sotuvchi (siz) Telegram ID. Bo'sh qoldirsangiz ham ishlaydi:
#    botga BIRINCHI /start yozgan kishi avtomatik sotuvchi bo'lib qoladi.
#    Aniq bilganingizda yozing. Bir nechta bo'lsa vergul bilan: 123456789,987654321
ADMIN_CHAT_ID=

# 3) Do'kon nomi (xohlagan matn)
STORE_NAME=Kiyim do'koni

# 4) Mini-ilova (Telegram WebApp) manzili — FAQAT https.
#    Bo'sh bo'lsa bot salomni tugmasiz yuboradi (illovaga urilmaydi).
#    Render/Railway'da: https://_adres_.onrender.com/app
WEB_APP_URL=

# 5) Port. Render o'zi beradi; local test: PORT=8130 node index.js
PORT=
